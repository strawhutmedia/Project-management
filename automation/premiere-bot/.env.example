# Copy to .env (same folder) and fill in. Never commit .env.
# The one credential the bot has: Slate's QA service token (set on Railway
# as QA_SERVICE_TOKEN — Ryan has it). Read/report on /api/qa/* only.
QA_SERVICE_TOKEN=
# Optional overrides:
# SLATE_BASE_URL=https://slate.strawhutmedia.com
# POLL_SECONDS=60
# Assembly holds while Premiere is open or free RAM is below this (GB),
# rechecking every poll. BUSY_CHECK=off disables the hold entirely.
# BUSY_MIN_FREE_GB=6
# BUSY_CHECK=on
