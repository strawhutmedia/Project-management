# Copy to .env for local dev, or set these on Railway.
#
# If DATABASE_URL is set, shows are stored in Postgres (production).
# If it is NOT set, shows are stored in a local JSON file under ./data
# so the app runs anywhere with zero setup.
DATABASE_URL=

# Password for the /admin area. Change this before deploying.
ADMIN_PASSWORD=changeme

# How often (minutes) to re-check every show's feed for new episodes.
SYNC_INTERVAL_MINUTES=30

# Public base URL (used for absolute links / SEO tags).
APP_BASE_URL=https://www.strawhutmedia.com

# Injected automatically by Railway.
PORT=8080
